msgid "ISyCode  ·  COMMAND BROWSER"
msgstr "ISyCode  ·  EXPLORADOR DE COMANDOS"

msgid "Categories"
msgstr "Categorías"

msgid "Choose an action"
msgstr "Elige una acción"

msgid "Agent · Workspace · Integrations · Providers · Session · Settings"
msgstr "Agente · Espacio · Integraciones · Proveedores · Sesión · Configuración"

msgid "Type to filter; press Tab to move to the list. Use ↑/↓ and Enter to inspect an action. Ctrl+O opens it; Esc clears the filter or goes back. In chat, type / for quick commands."
msgstr "Escribe para filtrar; Tab pasa a la lista. ↑/↓ y Enter inspeccionan una acción. Ctrl+O la abre; Esc limpia el filtro o vuelve. En el chat, escribe / para comandos rápidos."

msgid "Open action · Ctrl+O"
msgstr "Abrir acción · Ctrl+O"

msgid "Search commands…"
msgstr "Buscar comandos…"

msgid "Copy selection / text"
msgstr "Copiar selección / texto"

msgid "Close"
msgstr "Cerrar"

msgid "Add sibling folder"
msgstr "Añadir carpeta hermana"

msgid "Allow proposed file edits"
msgstr "Permitir ediciones de archivo propuestas"

msgid "This grants reads/searches and optionally edits for this exact folder. Every edit asks until you explicitly enable automatic edits. Commands and other projects receive no new access."
msgstr "Esto concede lecturas/búsquedas y, si lo marcas, ediciones de esta carpeta exacta. Cada edición pregunta hasta que actives las ediciones automáticas. Los comandos y otros proyectos no ganan acceso."

msgid "Cancel"
msgstr "Cancelar"

msgid "Add folder"
msgstr "Añadir carpeta"

msgid "Danger: allow automatic file edits"
msgstr "Peligro: permitir ediciones automáticas"

msgid "The assistant may create or overwrite files here without showing each diff for approval. Model mistakes or malicious instructions in files can damage your work. Review changes with Git and keep backups."
msgstr "El asistente puede crear o sobrescribir archivos aquí sin mostrar cada diff para aprobarlo. Errores del modelo o instrucciones maliciosas en archivos pueden dañar tu trabajo. Revisa los cambios con Git y guarda copias."

msgid "This setting persists for this workspace. Disable it from Files → Folders. Authority, ISySentinel, path protections and journaling stay active; they cannot guarantee that an allowed edit is correct. Commands, deletes, moves and commits still require their own approvals."
msgstr "Este ajuste permanece en este espacio. Desactívalo en Archivos → Carpetas. Authority, ISySentinel, las protecciones de ruta y el diario siguen activos; no garantizan que una edición permitida sea correcta. Comandos, borrados, movimientos y commits siguen pidiendo su propia aprobación."

msgid "Enable automatic edits"
msgstr "Activar ediciones automáticas"

msgid "Alias, e.g. other-project"
msgstr "Alias, p. ej. otro-proyecto"

msgid "Cancel sign-in"
msgstr "Cancelar inicio de sesión"

msgid "Sign in with ChatGPT"
msgstr "Entrar con ChatGPT"

msgid "Open this official link in your browser. Browser login requires the browser on the same computer as ISyCode; use device code for remote/headless machines."
msgstr "Abre este enlace oficial en el navegador. El inicio en el navegador necesita el navegador en el mismo equipo que ISyCode; en máquinas remotas o sin pantalla usa el código de dispositivo."

msgid "Waiting for sign-in… Your plan determines available models and usage limits. This does not add API credits."
msgstr "Esperando el inicio de sesión… Tu plan determina los modelos disponibles y los límites de uso. Esto no añade créditos de API."

