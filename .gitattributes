# Integrity-pinned resources must preserve their committed bytes on every OS.
.gitattributes text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
.github/workflows/** text eol=lf
src/isycode/bundled_skills/** -text
# Raw execution evidence is byte-preserved, including UTF-16 Windows logs.
docs/platform-parity/evidence/** -text
# Parity manifests attest the exact documentation and evidence bytes.
docs/platform-parity/** -text whitespace=cr-at-eol
# Gate evidence and decisions are content-addressed; checkout must preserve blob bytes.
docs/evidence/** -text
docs/decisions/** -text
docs/security/m15-authority-coverage.json text eol=lf
docs/superpowers/plans/2026-10-14-windows-command-sandbox.md -text
docs/superpowers/plans/2026-10-14-windows-bounded-scratch.md -text
